# ==============================================================================
# ai-pr-reviewer Environment Configuration (Vecesta.co)
# ==============================================================================

# AI Provider selection: gemini | ollama | openai | mock
AI_PROVIDER=gemini

# Specific Model ID (defaults: gemini-1.5-flash | qwen2.5-coder:latest | gpt-4o-mini)
AI_MODEL=gemini-1.5-flash

# API Credentials (leave empty if using Ollama or Mock)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Custom API Base URL (optional for Ollama or custom OpenAI-compatible endpoints)
AI_ENDPOINT=http://127.0.0.1:11434

# Minimum severity level to report in reviews (SECURITY, CRITICAL, MAJOR, MINOR, NIT)
MIN_SEVERITY=NIT

# Comma-separated list of severities that fail the CI gate and exit with code 1
FAIL_ON_SEVERITY=CRITICAL,SECURITY

# Enable verbose logging
DEBUG=false
