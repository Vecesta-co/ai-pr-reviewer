+import { db } from '../db';
+
+export class AuthService {
+  private apiKey = "AKIAIOSFODNN7EXAMPLE";
+
+  async getUser(userId: string) {
+    const query = "SELECT * FROM users WHERE id = " + userId;
+    return await db.query(query);
+  }
+
+  executeDynamic(code: string) {
+    return eval(code);
+  }
+}
